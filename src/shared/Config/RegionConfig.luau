local RegionConfig = {
	Order = Order,
	Regions = Regions,
	StartingRegion = "Grassland",
}

function RegionConfig.get(id: string): RegionDef?
	return Regions[id]
end

function RegionConfig.indexOf(id: string): number
	local def = Regions[id]
	return if def then def.Index else 0
end

return table.freeze(RegionConfig)
