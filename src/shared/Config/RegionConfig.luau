--!strict
-- Regions in progression order. Region index drives the default income/stat
-- scale of monsters and enemies that belong to it, so adding a region means
-- adding one entry here plus its monsters/dice/encounters.

export type RegionTheme = {
	Ground: Color3,
	GroundMaterial: Enum.Material,
	Accent: Color3,
	AccentMaterial: Enum.Material,
	Sky: Color3,
	Fog: Color3,
	Decor: "Grass" | "Forest" | "Desert" | "Mountain" | "Volcano" | "Cave" | "Heaven" | "Cosmic" | "Glitch",
}

export type RegionDef = {
	Id: string,
	DisplayName: string,
	Index: number,
	Description: string,
	DiceId: string,
	MaterialId: string,
	BossEncounterId: string,
	UnlockCost: number, -- Coins
	RequiresBossOf: string?, -- region whose boss must be defeated first
	RequiredRebirths: number,
	RecommendedPower: number, -- team power hint shown on the region card; keep near the boss encounter power (Balance.spec)
	IncomeScale: number, -- base income of a Common monster from this region (coins/sec)
	StatScale: number, -- multiplier applied to archetype stats for monsters/enemies of this region
	Theme: RegionTheme,
	CacheRewardCoins: number, -- daily exploration cache reward (per cache)
	CacheCount: number,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

